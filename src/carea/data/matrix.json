  "mcp_profiles": {
    "rea": {
      "hot_cold": {
        "min_rea_version": "6.10.0",
        "env": {
          "REA_MCP_TOOL_CATALOG_PROFILE": "hot-cold",
          "REA_MCP_INPUT_SCHEMA_PROFILE": "compact",
          "REA_MCP_OUTPUT_SCHEMA_PROFILE": "off"
        }
      },
      "master": {
        "min_rea_version": "6.10.0",
        "env": {
          "REA_MCP_TOOL_CATALOG_PROFILE": "hot-cold",
          "REA_MCP_INPUT_SCHEMA_PROFILE": "compact",
          "REA_MCP_OUTPUT_SCHEMA_PROFILE": "off",
          "REA_ASAR_MAX_HEADER_BYTES": "268435456",
          "REA_NATIVE_MATCHING_REPRESENTATION_BYTES": "1073741824",
          "REA_CAPTURE_DECODER_OLD_GENERATION_MIB": "2048"
        }
      },
      "all_families": {
        "min_rea_version": "6.10.0",
        "env": {
          "REA_MCP_TOOL_FAMILIES": "direct,enhanced,native,artifact,managed,firmware,uefi,android,pcap,flutter,frida,apktool,jeb,adb,browser,electron,javascript-runtime,application,session",
          "REA_MCP_INPUT_SCHEMA_PROFILE": "compact",
          "REA_MCP_OUTPUT_SCHEMA_PROFILE": "off"
        }
      },
      "native": {
        "env": {
          "REA_MCP_TOOL_FAMILIES": "native,enhanced,application,session",
          "REA_MCP_INPUT_SCHEMA_PROFILE": "compact",
          "REA_MCP_OUTPUT_SCHEMA_PROFILE": "off"
        }
      },
      "web_js_electron": {
        "env": {
          "REA_MCP_TOOL_FAMILIES": "browser,electron,application,javascript-runtime,session",
          "REA_MCP_INPUT_SCHEMA_PROFILE": "compact",
          "REA_MCP_OUTPUT_SCHEMA_PROFILE": "off"
        }
      },
      "android_mobile": {
        "env": {
          "REA_MCP_TOOL_FAMILIES": "android,apktool,jeb,flutter,frida,adb,application,session",
          "REA_MCP_INPUT_SCHEMA_PROFILE": "compact",
          "REA_MCP_OUTPUT_SCHEMA_PROFILE": "off"
        }
      },
      "firmware_uefi": {
        "min_rea_version": "6.10.0",
        "env": {
          "REA_MCP_TOOL_FAMILIES": "firmware,uefi,artifact,session,direct",
          "REA_MCP_INPUT_SCHEMA_PROFILE": "compact",
          "REA_MCP_OUTPUT_SCHEMA_PROFILE": "off"
        }
      },
      "managed_dotnet": {
        "env": {
          "REA_MCP_TOOL_FAMILIES": "managed,artifact,application,session",
          "REA_MCP_INPUT_SCHEMA_PROFILE": "compact",
          "REA_MCP_OUTPUT_SCHEMA_PROFILE": "off"
        }
      }
    },
    "craft_anything": {
      "clean_room_default": {
        "command": "craft-anything-cli",
        "args": [
          "mcp",
          "--clean-room"
        ]
      },
      "clean_room_restricted_web": {
        "command": "craft-anything-cli",
        "args": [
          "mcp",
          "--clean-room",
          "--restricted",
          "--allow-web",
          "--allow-capture"
        ]
      },
      "private_deep_rebuild": {
        "command": "craft-anything-cli",
        "args": [
          "mcp",
          "--deep"
        ]
      },
      "deep_full": {
        "command": "craft-anything-cli",
        "args": [
          "mcp",
          "--deep",
          "--all-tools"
        ]
      }
